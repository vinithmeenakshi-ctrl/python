class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

def middle(head):
    slow = head
    fast = head

    while fast and fast.next:
        slow = slow.next
        fast = fast.next.next

    return slow.data

head = Node(5)
head.next = Node(10)
head.next.next = Node(15)
head.next.next.next = Node(20)
head.next.next.next.next = Node(25)

print(middle(head))
